   ],
   "source": [
    "# 學生分數總分為 300分\n",
    "# 有些學生可以加 5%\n",
    "\n",
    "scores = int(input('請輸入學生的分數(最高300分)'))\n",
    "is_add = input('學生是否符合加分條件(y/n)?')\n",
    "\n",
    "if is_add == \"y\":\n",
    "    scores = scores * 1.05\n",
    "\n",
    "#四捨五入(5進位)\n",
    "scores = int(scores + 0.5)\n",
    "\n",
    "print('學生的分數是: ', scores)"
   ]
  }
 ],
